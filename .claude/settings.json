      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv run python -m scripts.checks.:*)",
      "Bash(uv sync:*)",
      "Bash(npm --prefix ui run build:*)",
