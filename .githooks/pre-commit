#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
# Fast read-only gates first; the bundle rebuild, ruff and the unit suite last.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

uv run --quiet python -m scripts.checks.secret_scan
uv run --quiet python -m scripts.checks.missing_tests
uv run --quiet python -m scripts.checks.file_sizes
node scripts/self-documentation/generate.js --staged
uv run --quiet python -m scripts.checks.ui_build
uv run --quiet ruff check
uv run --quiet pytest -q
