#!/usr/bin/env bash
# Postgres-only tests need a disposable database; CI's postgres job runs them on every push.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ -n "${TEST_DATABASE_URL:-}" ]; then
  uv run --quiet pytest -q -m pg
else
  echo "pre-push: TEST_DATABASE_URL unset, skipping Postgres tests (CI runs them)."
fi
